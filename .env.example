# Local development configuration template
# Copy to .env and populate with your credentials.

# Vertex AI & GCP Project
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_SEARCH_DATASTORE_ID=medquad-grounding-corpus
VERTEX_SEARCH_APP_ID=medquad-search-app
GROUNDING_GCS_BUCKET=your-gcs-bucket-name

# (Optional) Alternatively, for Gemini API via Google AI Studio:
# GEMINI_API_KEY=your-gemini-api-key

# Cloud SQL PostgreSQL Configuration
CLOUD_SQL_CONNECTION_NAME=your-project:us-central1:your-instance
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_NAME=medquad_clinical
POSTGRES_INSTANCE_IP=your-instance-ip

# MCP Microservice Transport (Cloud Run / Local)
PORT=8080
MCP_TRANSPORT=sse
MCP_SERVER_URL=http://localhost:8080/sse
